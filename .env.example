# ── Database ────────────────────────────────────────────────────────────────
# Local development (SQLite file in the project root):
DATABASE_URL="file:./dev.db"
# Production (Neon / Supabase) — the provider switches automatically:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"          # pooled
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"            # optional, used by migrations
# DATABASE_POOL_MAX=5   # optional Postgres pool size per server instance (use 1 with `npx prisma dev`)

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Required when not on Vercel / behind a proxy you trust:
AUTH_TRUST_HOST=true
