{
  "name": "ledgerly-expense-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:schema && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/prisma-schema.mjs && prisma generate",
    "db:schema": "node scripts/prisma-schema.mjs",
    "db:generate": "npm run db:schema && prisma generate",
    "db:migrate": "npm run db:schema && prisma migrate dev",
    "db:migrations:pg": "node scripts/prisma-schema.mjs --provider postgresql --out prisma/schema.pg.tmp.prisma && node scripts/pg-baseline.mjs",
    "db:deploy": "npm run db:schema && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "npm run db:schema && prisma migrate reset --force && npm run db:seed",
    "db:studio": "prisma studio",
    "test:pg": "node -e \"if(!process.env.TEST_DATABASE_URL){console.error('Set TEST_DATABASE_URL to a disposable Postgres database');process.exit(1)}\" && vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.12"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.15"
  }
}
